<UserControl x:Class="TreeCounterAddin.TreeCounterDockpaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TreeCounterAddin"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="300">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:BilingualTooltipConverter x:Key="BilingualTooltip"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <local:UiTextConverter x:Key="UiText"/>
        <local:IndexToVisibilityConverter x:Key="IdxVis"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusLine" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="HintLine" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Every feature section is an Expander with this style so each tab stays
             collapsible/compact - every section defaults collapsed so a tab with several
             features opens tidy instead of showing every form at once. BasedOn the implicit Expander
             style ArcGIS Pro registers app-wide - without it, a keyed style with no BasedOn
             falls back to WPF's raw stock chrome (a circular chevron) instead of Pro's own
             flat-arrow look, which is what made these look inconsistent with the Settings
             Expanders below (which had no explicit Style, so picked up Pro's implicit one). -->
        <Style x:Key="SectionExpander" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionContent" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="TabContent" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="{Binding Heading}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                <TextBlock Text="{local:Tr Layers}" DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="{local:Tr Refresh}" Command="{Binding RefreshLayersCommand}"
                        DockPanel.Dock="Right" Padding="6,0" FontSize="10"
                        ToolTip="{local:Tr RefreshTooltip}"/>
            </DockPanel>

            <!-- Grouped by where each feature sits in the field workflow: get the area ready,
                 bring field data back in, run analysis on it, then the rarely-touched settings. -->
            <DockPanel LastChildFill="True">
                <!-- ArcGIS Pro's own catalog-pane tab strip (ListBox + Esri_ListBoxPanelIndicator,
                     see Esri/arcgis-pro-sdk-community-samples Framework/CustomCatalog) instead of a
                     plain WPF TabControl - feedback from an Esri Community post about this project
                     (2026-09-05). Content still lives in one Grid below with each tab's panel shown
                     only when SelectedTabIndex matches its own index (IndexToVisibilityConverter) -
                     same single shared TreeCounterDockpaneViewModel as before, just a different
                     strip chrome, not a per-tab ViewModel/DataTemplate split.

                     ItemsPanel forced to a WrapPanel (overriding whatever the style sets, since a
                     local property wins over a Style setter) - Esri_ListBoxPanelIndicator's own
                     built-in "..." overflow flyout renders blank rows for our 8 tabs in a narrow
                     docked panel (Esri's own CustomCatalog sample only ever puts ~2 items in this
                     style, so its overflow flyout is likely just undertested past that). Wrapping to
                     a 2nd line instead avoids that flyout entirely, keeping labels always readable. -->
                <ListBox DockPanel.Dock="Top" Style="{DynamicResource Esri_ListBoxPanelIndicator}"
                         SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Content="{local:Tr Tab_Prepare}"/>
                    <ListBoxItem Content="{local:Tr Tab_FieldData}"/>
                    <ListBoxItem Content="{local:Tr Tab_Analyze}"/>
                    <ListBoxItem Content="{local:Tr Tab_Favorites}"/>
                    <ListBoxItem Content="{local:Tr Tab_History}"/>
                    <ListBoxItem Content="{local:Tr Tab_Settings}"/>
                    <ListBoxItem Content="{local:Tr Tab_Help}"/>
                    <ListBoxItem Content="{local:Tr Tab_About}"/>
                </ListBox>
                <Grid>
                    <StackPanel Style="{StaticResource TabContent}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IdxVis}, ConverterParameter=0}">
                        <Expander Header="{local:Tr FlightPlanner_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr FlightPlanner_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{local:Tr FlightPlanner_SurveyAreaLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PolygonLayers}" SelectedItem="{Binding SelectedFlightPlanningLayer}" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- ToolTip on both the label and the box (same bilingual lookup, see
                                         BilingualTooltipConverter.cs) - hover either to see it, and it
                                         switches language with whatever's picked on the Help tab
                                         (IsHelpEnglish is shared app-wide, not a second language toggle). -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Tr FlightPlanner_AltitudeLabel}" VerticalAlignment="Center"
                                               ToolTip="{local:TrTip Altitude}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FlightAltitudeM}" Margin="0,2"
                                             ToolTip="{local:TrTip Altitude}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Tr FlightPlanner_GsdLabel}" VerticalAlignment="Center"
                                               ToolTip="{local:TrTip Gsd}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FlightGsdCmPerPx}" Margin="0,2"
                                             ToolTip="{local:TrTip Gsd}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Tr FlightPlanner_ImageWidthLabel}" VerticalAlignment="Center"
                                               ToolTip="{local:TrTip ImageWidth}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FlightImageWidthPx}" Margin="0,2"
                                             ToolTip="{local:TrTip ImageWidth}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{local:Tr FlightPlanner_ImageHeightLabel}" VerticalAlignment="Center"
                                               ToolTip="{local:TrTip ImageHeight}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FlightImageHeightPx}" Margin="0,2"
                                             ToolTip="{local:TrTip ImageHeight}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{local:Tr FlightPlanner_FrontOverlapLabel}" VerticalAlignment="Center"
                                               ToolTip="{local:TrTip FrontOverlap}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FlightFrontOverlapPct}" Margin="0,2"
                                             ToolTip="{local:TrTip FrontOverlap}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{local:Tr FlightPlanner_SideOverlapLabel}" VerticalAlignment="Center"
                                               ToolTip="{local:TrTip SideOverlap}"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding FlightSideOverlapPct}" Margin="0,2"
                                             ToolTip="{local:TrTip SideOverlap}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{local:Tr FlightPlanner_DirectionLabel}" VerticalAlignment="Center"
                                               ToolTip="{local:TrTip Direction}"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding FlightDirectionDeg}" Margin="0,2"
                                             ToolTip="{local:TrTip Direction}"/>
                                    <!-- Full-width row (not squeezed into the 90px value column above) so these
                                         buttons stay readable even in a narrow docked panel. -->
                                    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                                                HorizontalAlignment="Right" Margin="0,0,0,2">
                                        <Button Content="{local:Tr FlightPlanner_Vertical}" Command="{Binding SetDirectionVerticalCommand}"
                                                Padding="6,2" ToolTip="{local:Tr FlightPlanner_VerticalTooltip}"/>
                                        <Button Content="{local:Tr FlightPlanner_Horizontal}" Command="{Binding SetDirectionHorizontalCommand}"
                                                Padding="6,2" Margin="4,0,0,0" ToolTip="{local:Tr FlightPlanner_HorizontalTooltip}"/>
                                        <Button Content="{local:Tr FlightPlanner_Suggest}" Command="{Binding SuggestDirectionCommand}"
                                                Padding="6,2" Margin="4,0,0,0"
                                                ToolTip="{local:Tr FlightPlanner_SuggestTooltip}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{local:Tr FlightPlanner_SpeedLabel}" VerticalAlignment="Center"
                                               ToolTip="{local:TrTip Speed}"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding FlightSpeedMs}" Margin="0,2"
                                             ToolTip="{local:TrTip Speed}"/>
                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{local:Tr FlightPlanner_BatteryLabel}" VerticalAlignment="Center"
                                               ToolTip="{local:TrTip Battery}"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding MaxFlightMinutesPerBattery}" Margin="0,2"
                                             ToolTip="{local:TrTip Battery}"/>
                                    <CheckBox Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Content="{local:Tr FlightPlanner_CrossHatch}"
                                              IsChecked="{Binding CrossHatch}" Margin="0,4,0,2"/>
                                    <CheckBox Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Content="{local:Tr FlightPlanner_CorridorMode}"
                                              IsChecked="{Binding CorridorMode}" Margin="0,2,0,2"
                                              ToolTip="{local:Tr FlightPlanner_CorridorModeTooltip}"/>
                                </Grid>

                                <StackPanel Visibility="{Binding CorridorMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="{local:Tr FlightPlanner_CenterlineLabel}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding PolylineLayers}" SelectedItem="{Binding SelectedCorridorCenterlineLayer}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{local:Tr FlightPlanner_GenerateMission}" Command="{Binding GenerateMissionCommand}" Style="{StaticResource ActionButton}"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsGeneratingMission, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding FlightMissionStatus}" Style="{StaticResource StatusLine}"/>

                                <TextBlock Text="{local:Tr FlightPlanner_ExportFormatLabel}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                                <ComboBox ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding SelectedExportFormat}" Margin="0,0,0,8"/>

                                <StackPanel Visibility="{Binding IsKmzFormatSelected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{local:Tr FlightPlanner_DroneModelLabel}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding DroneModelNames}" SelectedItem="{Binding SelectedDroneModel}" Margin="0,0,0,8"/>
                                </StackPanel>

                                <Button Content="{local:Tr FlightPlanner_ExportMission}" Command="{Binding ExportMissionCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr Fishnet_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr Fishnet_PlanningLayerLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PolygonLayers}" SelectedItem="{Binding SelectedPolygonLayer}" Margin="0,0,0,8"/>

                                <TextBlock Text="{local:Tr Fishnet_CellSizeLabel}" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox Text="{Binding CellWidth}" Width="60"/>
                                    <TextBlock Text=" x " VerticalAlignment="Center" Margin="4,0"/>
                                    <TextBox Text="{Binding CellHeight}" Width="60"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{local:Tr Fishnet_Create}" Command="{Binding CreateFishnetCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{local:Tr Cancel}" Command="{Binding CancelFishnetCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsCreatingFishnet, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsCreatingFishnet, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding FishnetStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr Gpx_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr Gpx_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{local:Tr Layer}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding GpxLayers}" SelectedItem="{Binding SelectedGpxLayer}" Margin="0,0,0,8"/>

                                <Button Content="{local:Tr Gpx_Export}" Command="{Binding ExportGpxCommand}" Style="{StaticResource ActionButton}"/>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsExportingGpx, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding GpxStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <StackPanel Style="{StaticResource TabContent}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IdxVis}, ConverterParameter=1}">
                        <Expander Header="{local:Tr ExcelImport_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr ExcelImport_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <Button Content="{local:Tr ExcelImport_DownloadTemplate}" Command="{Binding DownloadTemplateCommand}" Style="{StaticResource ActionButton}"/>
                                <TextBlock Text="{Binding TemplateStatus}" Style="{StaticResource StatusLine}" Margin="0,4,0,10"/>

                                <TextBlock Text="{local:Tr ExcelImport_CoordSystemLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding UtmZoneOptions}" SelectedItem="{Binding SelectedUtmZoneLabel}" Margin="0,0,0,8"/>

                                <StackPanel Visibility="{Binding IsOtherZoneSelected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{local:Tr ExcelImport_WkidLabel}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CruisingWkid}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{local:Tr ExcelImport_Import}" Command="{Binding ImportExcelCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{local:Tr Cancel}" Command="{Binding CancelImportExcelCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsImportingExcel, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsImportingExcel, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding ImportExcelStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr PhotoImport_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr PhotoImport_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{local:Tr PhotoImport_Import}" Command="{Binding ImportPhotosCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{local:Tr Cancel}" Command="{Binding CancelImportPhotosCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsImportingPhotos, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsImportingPhotos, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding PhotoImportStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr PhotoOcr_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr PhotoOcr_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{local:Tr PhotoOcr_FormatLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding OcrFormatOptions}" SelectedItem="{Binding OcrFormat}" Margin="0,0,0,8"/>

                                <StackPanel Visibility="{Binding IsUtmFormatSelected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{local:Tr PhotoOcr_DefaultZoneLabel}" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox Text="{Binding OcrDefaultZone}" Width="50"/>
                                        <ComboBox ItemsSource="{Binding OcrHemisphereOptions}" SelectedItem="{Binding OcrDefaultHemisphere}" Width="120" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Content="{local:Tr PhotoOcr_SelectPhotos}" Command="{Binding ScanPhotosForCoordinatesCommand}" Style="{StaticResource ActionButton}"
                                        ToolTip="{local:Tr PhotoOcr_SelectPhotosTooltip}"/>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsScanningPhotos, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding PhotoOcrStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr CruisingReport_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr CruisingReport_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{local:Tr CruisingReport_LayerLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PointLayers}" SelectedItem="{Binding SelectedReportLayer}" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{local:Tr CruisingReport_Generate}" Command="{Binding GenerateReportCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{local:Tr Cancel}" Command="{Binding CancelReportCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsGeneratingReport, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsGeneratingReport, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding ReportStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <StackPanel Style="{StaticResource TabContent}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IdxVis}, ConverterParameter=2}">
                        <Expander Header="{local:Tr TreeDetection_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr RasterLayerLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding RasterLayers}" SelectedItem="{Binding SelectedRasterLayer}" Margin="0,0,0,8"/>

                                <TextBlock Text="{local:Tr TreeDetection_ProfileLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Margin="0,0,0,8"/>

                                <TextBlock Text="{local:Tr TreeDetection_ExcludeAreaLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PolygonLayers}" SelectedItem="{Binding SelectedTreeExcludeAreaLayer}" Margin="0,0,0,8"/>

                                <CheckBox Content="{local:Tr TreeDetection_ExcludeCleared}"
                                          IsChecked="{Binding ExcludeClearedLand}" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{local:Tr TreeDetection_Detect}" Command="{Binding RunDetectionCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{local:Tr Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <Grid Margin="0,8,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}"
                                               HorizontalAlignment="Right" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr LandClearing_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr LandClearing_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{local:Tr RasterLayerLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding RasterLayers}" SelectedItem="{Binding SelectedLandClearingRasterLayer}" Margin="0,0,0,8"/>

                                <TextBlock Text="{local:Tr LandClearing_ExcludeAreaLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PolygonLayers}" SelectedItem="{Binding SelectedExcludeAreaLayer}" Margin="0,0,0,8"/>

                                <TextBlock Text="{local:Tr LandClearing_MinAreaLabel}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding MinClearingAreaHa}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{local:Tr LandClearing_Detect}" Command="{Binding DetectLandClearingCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{local:Tr Cancel}" Command="{Binding CancelLandClearingCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsDetectingLandClearing, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <Grid Margin="0,8,0,0" Visibility="{Binding IsDetectingLandClearing, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding LandClearingProgress}" Height="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LandClearingProgress, StringFormat={}{0}%}"
                                               HorizontalAlignment="Right" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="{Binding LandClearingStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr ColorSampler_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr ColorSampler_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{local:Tr RasterLayerLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding RasterLayers}" SelectedItem="{Binding SelectedColorSamplerRasterLayer}" Margin="0,0,0,8"
                                          IsEnabled="{Binding IsColorSampling, Converter={StaticResource InverseBool}}"/>

                                <TextBlock Text="{local:Tr ColorSampler_CategoryLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding SampleCategories}" Text="{Binding SelectedSampleCategory, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" Margin="0,0,0,8"
                                          IsEnabled="{Binding IsColorSampling, Converter={StaticResource InverseBool}}"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{local:Tr ColorSampler_Start}" Command="{Binding StartColorSamplingCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{local:Tr ColorSampler_Stop}" Command="{Binding StopColorSamplingCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsColorSampling, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding ColorSamplerStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr RoadExtraction_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr RoadExtraction_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{local:Tr RasterLayerLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding RasterLayers}" SelectedItem="{Binding SelectedRoadRasterLayer}" Margin="0,0,0,8"/>

                                <TextBlock Text="{local:Tr RoadExtraction_MinDangleLabel}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding MinDangleM}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                                <TextBlock Text="{local:Tr RoadExtraction_MaxWidthLabel}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding MaxRoadWidthM}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{local:Tr RoadExtraction_Extract}" Command="{Binding ExtractRoadsCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{local:Tr Cancel}" Command="{Binding CancelRoadExtractionCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsExtractingRoads, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <Grid Margin="0,8,0,0" Visibility="{Binding IsExtractingRoads, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding RoadExtractionProgress}" Height="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RoadExtractionProgress, StringFormat={}{0}%}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="{Binding RoadExtractionStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr CompareChanges_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr CompareChanges_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{local:Tr CompareChanges_OldLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PointLayers}" SelectedItem="{Binding SelectedCompareOldLayer}" Margin="0,0,0,8"/>

                                <TextBlock Text="{local:Tr CompareChanges_NewLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PointLayers}" SelectedItem="{Binding SelectedCompareNewLayer}" Margin="0,0,0,8"/>

                                <TextBlock Text="{local:Tr CompareChanges_MatchDistLabel}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding CompareMaxDistM}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                                <Button Content="{local:Tr CompareChanges_Compare}" Command="{Binding CompareChangesCommand}" Style="{StaticResource ActionButton}"/>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsComparingChanges, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding CompareChangesStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr Firms_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr Firms_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{local:Tr Firms_SourceLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding FirmsSources}" SelectedItem="{Binding SelectedFirmsSource}" Margin="0,0,0,8"/>

                                <TextBlock Text="{local:Tr Firms_DayRangeLabel}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FirmsDayRange}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{local:Tr Firms_Load}" Command="{Binding LoadFirmsHotspotsCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{local:Tr Cancel}" Command="{Binding CancelFirmsCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsLoadingFirms, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsLoadingFirms, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding FirmsStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr Sliver_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr Sliver_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{local:Tr Sliver_LayerLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PolygonLayers}" SelectedItem="{Binding SelectedSliverLayer}" Margin="0,0,0,8"/>

                                <Button Content="{local:Tr Sliver_Detect}" Command="{Binding DetectSliversCommand}" Style="{StaticResource ActionButton}"/>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsDetectingSlivers, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding SliverStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr Biomass_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr Biomass_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{local:Tr Biomass_LayerLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PointLayers}" SelectedItem="{Binding SelectedBiomassLayer}" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Tr Biomass_WoodDensityLabel}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WoodDensity}" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Tr Biomass_ExpansionFactorLabel}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BiomassExpansionFactor}" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Tr Biomass_RootShootLabel}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RootShootRatio}" Margin="0,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{local:Tr Biomass_CarbonFractionLabel}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CarbonFraction}" Margin="0,2"/>
                                </Grid>

                                <Button Content="{local:Tr Biomass_Estimate}" Command="{Binding EstimateBiomassCommand}" Style="{StaticResource ActionButton}"/>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsEstimatingBiomass, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding BiomassStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr Slope_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr Slope_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{local:Tr Slope_DemLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding RasterLayers}" SelectedItem="{Binding SelectedDemLayer}" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{local:Tr Slope_Compute}" Command="{Binding ComputeSlopeCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{local:Tr Cancel}" Command="{Binding CancelSlopeCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsComputingSlope, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsComputingSlope, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding SlopeStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr Riparian_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{local:Tr Riparian_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{local:Tr Riparian_RiverLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding GpxLayers}" SelectedItem="{Binding SelectedRiverLayer}" Margin="0,0,0,8"/>

                                <TextBlock Text="{local:Tr Riparian_PlanLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PolygonLayers}" SelectedItem="{Binding SelectedBufferPlanLayer}" Margin="0,0,0,8"/>

                                <TextBlock Text="{local:Tr Riparian_DistanceLabel}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding BufferDistanceM}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{local:Tr Riparian_Check}" Command="{Binding CheckRiparianBufferCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{local:Tr Cancel}" Command="{Binding CancelRiparianBufferCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsCheckingBuffer, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsCheckingBuffer, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding BufferStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- Marks layers the user cares about without touching the layer itself (no
                         rename - a layer's Name also drives its legend text in a layout, so a
                         "⭐ " prefix would silently show up there too) - lives entirely in this
                         add-in, see FavoritesStore. Its own tab (not a persistent section above
                         the tab strip, tried first) so a long favorites list can't push the tab
                         headers themselves out of view. -->
                    <StackPanel Style="{StaticResource TabContent}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IdxVis}, ConverterParameter=3}">
                        <TextBlock Text="{local:Tr Favorites_SearchLabel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LayerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4" ToolTip="{local:Tr Favorites_SearchTooltip}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox ItemsSource="{Binding FilteredLayerNames}" SelectedItem="{Binding SelectedLayerToFavorite}" Width="180"/>
                            <Button Content="{local:Tr Favorites_Add}" Command="{Binding AddFavoriteCommand}" Padding="8,2" Margin="6,0,0,0" FontSize="11"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding FavoriteLayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2" LastChildFill="True">
                                        <Button Content="✕" DockPanel.Dock="Right" Padding="4,0" Margin="4,0,0,0" FontSize="10"
                                                ToolTip="{Binding DataContext.IsHelpEnglish, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource UiText}, ConverterParameter=Favorites_Remove}"
                                                Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsVisible, Mode=OneWay}"
                                                  ToolTip="{Binding DataContext.IsHelpEnglish, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource UiText}, ConverterParameter=Favorites_ToggleVisibility}"
                                                  Command="{Binding DataContext.ToggleFavoriteVisibilityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- A running log of what ran, when, and its result, across every feature -
                         see TreeCounterDockpaneViewModel.History.cs for how this is populated
                         generically off every feature's own "XxxStatus" property. -->
                    <StackPanel Style="{StaticResource TabContent}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IdxVis}, ConverterParameter=4}">
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock Text="{local:Tr History_Heading}" DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="{local:Tr Clear}" Command="{Binding ClearHistoryCommand}" DockPanel.Dock="Right" Padding="6,0" FontSize="10"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding RunHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Style="{StaticResource TabContent}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IdxVis}, ConverterParameter=5}">
                        <Expander Header="{local:Tr AdvancedParams_Header}" Margin="0,0,0,8">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Tr AdvancedParams_SigmaLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Sigma}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Tr AdvancedParams_ExgLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExgThreshold}" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Tr AdvancedParams_MinSmoothLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MinSmooth}" Margin="0,2"/>
                            </Grid>
                        </Expander>

                        <Expander Header="{local:Tr LandClearingParams_Header}" Margin="0,0,0,8">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="{local:Tr LandClearingParams_Hint}"
                                           TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11" Foreground="Gray"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Tr LandClearingParams_ExgLabel}" VerticalAlignment="Center"
                                               ToolTip="{local:Tr LandClearingParams_ExgTooltip}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LandClearingExgThreshold}" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Tr LandClearingParams_SmoothLabel}" VerticalAlignment="Center"
                                               ToolTip="{local:Tr LandClearingParams_SmoothTooltip}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LandClearingSmoothPx}" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Tr LandClearingParams_OpeningLabel}" VerticalAlignment="Center"
                                               ToolTip="{local:Tr LandClearingParams_OpeningTooltip}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LandClearingOpeningIterations}" Margin="0,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{local:Tr LandClearingParams_ClosingLabel}" VerticalAlignment="Center"
                                               ToolTip="{local:Tr LandClearingParams_ClosingTooltip}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LandClearingClosingIterations}" Margin="0,2"/>
                                </Grid>
                                <TextBlock Text="{local:Tr LandClearingParams_FillHoleLabel}" Margin="0,6,0,0"
                                           ToolTip="{local:Tr LandClearingParams_FillHoleTooltip}"/>
                                <TextBox Text="{Binding LandClearingFillHoleAreaM2}" Margin="0,2" HorizontalAlignment="Left" Width="100"/>
                                <CheckBox Content="{local:Tr LandClearingParams_FreshColor}"
                                          IsChecked="{Binding LandClearingFreshColor}" Margin="0,6,0,2"/>
                                <Grid Visibility="{Binding LandClearingFreshColor, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:Tr LandClearingParams_BrightMinLabel}" VerticalAlignment="Center"
                                               ToolTip="{local:Tr LandClearingParams_BrightMinTooltip}"/>
                                    <TextBox Grid.Column="1" Text="{Binding LandClearingBrightMin}" Margin="0,2"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{local:Tr AiValidation_Header}" Margin="0,0,0,8">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{local:Tr AiValidation_Hint}"
                                           TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11" Foreground="Gray"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="{local:Tr AiValidation_Enable}"
                                          IsChecked="{Binding UseAiValidation}" Margin="0,0,0,6"
                                          ToolTip="{local:Tr AiValidation_EnableTooltip}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Tr AiValidation_ProviderLabel}" VerticalAlignment="Center" IsEnabled="{Binding UseAiValidation}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" Margin="0,2" IsEnabled="{Binding UseAiValidation}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{local:Tr AiValidation_ModelLabel}" VerticalAlignment="Center" IsEnabled="{Binding UseAiValidation}"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" Margin="0,2" IsEnabled="{Binding UseAiValidation}"/>
                                <PasswordBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ApiKeyBox"
                                             PasswordChanged="ApiKeyBox_PasswordChanged" Margin="0,2" IsEnabled="{Binding UseAiValidation}"/>
                                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="{local:Tr AiValidation_TestKey}" Command="{Binding TestKeyCommand}" Padding="8,2" FontSize="10" IsEnabled="{Binding UseAiValidation}"/>
                                    <TextBlock Text="{Binding TestKeyStatus}" TextWrapping="Wrap" Margin="8,0,0,0"
                                               VerticalAlignment="Center" FontSize="10" Foreground="Gray"/>
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Expander Header="{local:Tr FirmsSettings_Header}" Margin="0,0,0,8">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="{local:Tr FirmsSettings_Hint}"
                                           TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11" Foreground="Gray"/>
                                <PasswordBox x:Name="FirmsMapKeyBox" PasswordChanged="FirmsMapKeyBox_PasswordChanged" Margin="0,2"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="{local:Tr FirmsSettings_TestKey}" Command="{Binding TestFirmsKeyCommand}" Padding="8,2" FontSize="10"/>
                                    <TextBlock Text="{Binding FirmsTestKeyStatus}" TextWrapping="Wrap" Margin="8,0,0,0"
                                               VerticalAlignment="Center" FontSize="10" Foreground="Gray"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <StackPanel Style="{StaticResource TabContent}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IdxVis}, ConverterParameter=6}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="English" Command="{Binding ShowHelpEnglishCommand}" Padding="10,4" Margin="0,0,6,0"
                                    IsEnabled="{Binding IsHelpIndonesian}"/>
                            <Button Content="Bahasa Indonesia" Command="{Binding ShowHelpIndonesianCommand}" Padding="10,4"
                                    IsEnabled="{Binding IsHelpEnglish}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding HelpEnglishText}" TextWrapping="Wrap"
                                   Visibility="{Binding IsHelpEnglish, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding HelpIndonesianText}" TextWrapping="Wrap"
                                   Visibility="{Binding IsHelpIndonesian, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource TabContent}" HorizontalAlignment="Center" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IdxVis}, ConverterParameter=7}">
                        <TextBlock Text="🌳" FontSize="56" HorizontalAlignment="Center" Margin="0,10,0,6"/>
                        <TextBlock Text="Forestry Toolkit" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AboutVersionText}" HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,14"/>

                        <TextBlock Text="Drone-orthophoto forestry analysis for ArcGIS Pro: tree/oil palm detection, land clearing and road/trail extraction, change comparison, biomass &amp; carbon estimation, cruising data import, and field-data tools - ported and extended from the original QGIS plugin, LandTree Analyzer."
                                   TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,0,0,14"/>

                        <TextBlock Text="{local:Tr About_DeveloperHeader}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                        <TextBlock Text="Ahmed Seko" HorizontalAlignment="Left" Margin="0,0,0,14"/>

                        <TextBlock Text="{local:Tr About_TechHeader}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,0,0,14">
                            <Run Text="• ArcGIS Pro SDK (.NET / C# / WPF) - this add-in shell"/><LineBreak/>
                            <Run Text="• Python (arcpy, numpy, scipy, scikit-image) - detection/analysis backend, runs inside ArcGIS Pro's own conda environment"/><LineBreak/>
                            <Run Text="• YOLOv8 (ONNX Runtime) - oil palm crown detection"/><LineBreak/>
                            <Run Text="• U-Net (ONNX Runtime, optional) - learned road-mask alternative to the ExG threshold"/><LineBreak/>
                            <Run Text="• Tesseract OCR - Photo Coordinate OCR"/><LineBreak/>
                            <Run Text="• Google Gemini / OpenAI / Anthropic Claude (optional, your own API key) - AI Vision Validation"/>
                        </TextBlock>

                        <TextBlock Text="{local:Tr About_SourceHeader}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                        <TextBlock Text="github.com/Ahmedseko/forestry-toolkit" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
